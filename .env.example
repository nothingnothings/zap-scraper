# ZenRows proxy (used by the scraper zap.py)
PROXY_URL=

# MySQL connection settings
# These are read by db_config.py (used by gui.py). They match the defaults
# defined in docker/docker-compose.yml, so you normally only need to change
# them if you customize the database setup.
DB_HOST=localhost
DB_PORT=3306
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase